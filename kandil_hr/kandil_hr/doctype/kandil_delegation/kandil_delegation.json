{
  "doctype": "DocType",
  "name": "Kandil Delegation",
  "module": "Kandil HR",
  "custom": 0,
  "engine": "InnoDB",
  "autoname": "hash",
  "field_order": [
    "company",
    "department",
    "from_user",
    "to_user",
    "from_date",
    "to_date",
    "reason",
    "revoked",
    "revocation_reason",
    "process_scope",
    "approval_status",
    "supersedes",
    "delegation_version",
    "approved_by",
    "approved_on",
    "decision_reason",
    "decision_key",
    "revision_key"
  ],
  "fields": [
    {
      "fieldname": "company",
      "label": "Company",
      "fieldtype": "Link",
      "reqd": 1,
      "in_list_view": 1,
      "options": "Company"
    },
    {
      "fieldname": "department",
      "label": "Department",
      "fieldtype": "Link",
      "reqd": 1,
      "in_list_view": 1,
      "options": "Department"
    },
    {
      "fieldname": "from_user",
      "label": "From User",
      "fieldtype": "Link",
      "reqd": 1,
      "options": "User"
    },
    {
      "fieldname": "to_user",
      "label": "To User",
      "fieldtype": "Link",
      "reqd": 1,
      "options": "User"
    },
    {
      "fieldname": "from_date",
      "label": "From Date",
      "fieldtype": "Date",
      "reqd": 1
    },
    {
      "fieldname": "to_date",
      "label": "To Date",
      "fieldtype": "Date",
      "reqd": 1
    },
    {
      "fieldname": "reason",
      "label": "Reason",
      "fieldtype": "Small Text",
      "reqd": 1
    },
    {
      "fieldname": "revoked",
      "label": "Revoked",
      "fieldtype": "Check",
      "default": "0"
    },
    {
      "fieldname": "process_scope",
      "label": "Delegated Process",
      "fieldtype": "Select",
      "options": "APPROVALS\nTEAM\nALL",
      "default": "APPROVALS",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "approval_status",
      "label": "Delegation Approval",
      "fieldtype": "Select",
      "options": "\nActive\nPending CEO\nRejected\nRevoked",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "supersedes",
      "label": "Previous Delegation Version",
      "fieldtype": "Link",
      "options": "Kandil Delegation",
      "read_only": 1
    },
    {
      "fieldname": "delegation_version",
      "label": "Delegation Version",
      "fieldtype": "Int",
      "default": "1",
      "read_only": 1
    },
    {
      "fieldname": "approved_by",
      "label": "Delegation Decided By",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "approved_on",
      "label": "Delegation Decided On",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "decision_reason",
      "label": "Delegation Decision Reason",
      "fieldtype": "Small Text",
      "read_only": 1
    },
    {
      "fieldname": "decision_key",
      "label": "Decision Receipt",
      "fieldtype": "Data",
      "read_only": 1,
      "hidden": 1
    },
    {
      "fieldname": "revision_key",
      "label": "Revision Receipt",
      "fieldtype": "Data",
      "read_only": 1,
      "hidden": 1
    },
    {
      "fieldname": "revocation_reason",
      "label": "Revocation Reason",
      "fieldtype": "Small Text",
      "depends_on": "eval:doc.revoked",
      "description": "Reason for stopping this delegation; the original delegation reason is retained."
    }
  ],
  "permissions": [
    {
      "role": "Kandil Sector Approver",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 0,
      "print": 1
    },
    {
      "role": "Kandil Approver",
      "read": 1,
      "write": 0,
      "create": 0,
      "report": 1,
      "export": 0,
      "print": 1
    },
    {
      "role": "Kandil CEO Approver",
      "read": 1,
      "print": 1
    }
  ],
  "track_changes": 1
}
