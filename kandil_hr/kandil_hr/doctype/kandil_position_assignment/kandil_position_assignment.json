{
  "doctype": "DocType",
  "name": "Kandil Position Assignment",
  "module": "Kandil HR",
  "custom": 0,
  "engine": "InnoDB",
  "autoname": "hash",
  "field_order": [
    "company",
    "department",
    "branch",
    "position",
    "employee",
    "user",
    "valid_from",
    "valid_until",
    "allocation",
    "remarks",
    "is_voided",
    "void_reason",
    "voided_by",
    "voided_on"
  ],
  "fields": [
    {
      "fieldname": "company",
      "label": "Company",
      "fieldtype": "Link",
      "options": "Company",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "department",
      "label": "Department",
      "fieldtype": "Link",
      "options": "Department",
      "reqd": 1
    },
    {
      "fieldname": "branch",
      "label": "Branch",
      "fieldtype": "Link",
      "options": "Branch"
    },
    {
      "fieldname": "position",
      "label": "Position",
      "fieldtype": "Link",
      "options": "Kandil Position",
      "reqd": 1
    },
    {
      "fieldname": "employee",
      "label": "Employee",
      "fieldtype": "Link",
      "options": "Employee",
      "reqd": 1
    },
    {
      "fieldname": "user",
      "label": "User",
      "fieldtype": "Link",
      "options": "User"
    },
    {
      "fieldname": "valid_from",
      "label": "Valid From",
      "fieldtype": "Date",
      "reqd": 1
    },
    {
      "fieldname": "valid_until",
      "label": "Valid Until",
      "fieldtype": "Date"
    },
    {
      "fieldname": "allocation",
      "label": "Allocation",
      "fieldtype": "Select",
      "options": "Primary\nActing",
      "default": "Primary"
    },
    {
      "fieldname": "remarks",
      "label": "Remarks",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "is_voided",
      "label": "Voided",
      "fieldtype": "Check",
      "read_only": 1,
      "default": "0",
      "in_list_view": 1
    },
    {
      "fieldname": "void_reason",
      "label": "Void Reason",
      "fieldtype": "Small Text",
      "read_only": 1
    },
    {
      "fieldname": "voided_by",
      "label": "Voided By",
      "fieldtype": "Link",
      "read_only": 1,
      "options": "User"
    },
    {
      "fieldname": "voided_on",
      "label": "Voided On",
      "fieldtype": "Datetime",
      "read_only": 1
    }
  ],
  "track_changes": 1,
  "permissions": [
    {
      "role": "Kandil Recruiter",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "print": 1
    },
    {
      "role": "Kandil Sector Approver",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "print": 1
    }
  ]
}
