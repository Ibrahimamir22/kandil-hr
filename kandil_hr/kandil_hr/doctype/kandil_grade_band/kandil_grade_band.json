{
  "doctype": "DocType",
  "name": "Kandil Grade Band",
  "module": "Kandil HR",
  "custom": 0,
  "engine": "InnoDB",
  "autoname": "hash",
  "field_order": [
    "company",
    "grade_code",
    "title",
    "valid_from",
    "valid_until",
    "currency",
    "minimum",
    "maximum",
    "status",
    "approved_by"
  ],
  "fields": [
    {
      "fieldname": "company",
      "label": "Company",
      "fieldtype": "Link",
      "options": "Company",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "grade_code",
      "label": "Grade Code",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "title",
      "label": "Title",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "valid_from",
      "label": "Valid From",
      "fieldtype": "Date",
      "reqd": 1
    },
    {
      "fieldname": "valid_until",
      "label": "Valid Until",
      "fieldtype": "Date"
    },
    {
      "fieldname": "currency",
      "label": "Currency",
      "fieldtype": "Link",
      "options": "Currency",
      "reqd": 1
    },
    {
      "fieldname": "minimum",
      "label": "Minimum",
      "fieldtype": "Currency",
      "reqd": 1
    },
    {
      "fieldname": "maximum",
      "label": "Maximum",
      "fieldtype": "Currency",
      "reqd": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Draft\nApproved\nRejected",
      "default": "Draft",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "approved_by",
      "label": "Approved By",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    }
  ],
  "track_changes": 1,
  "permissions": [
    {
      "role": "Kandil Recruiter",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "print": 1
    },
    {
      "role": "Kandil Sector Approver",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "print": 1
    }
  ]
}
