{
  "doctype": "DocType",
  "name": "Kandil Access Grant",
  "module": "Kandil HR",
  "custom": 0,
  "engine": "InnoDB",
  "autoname": "hash",
  "field_order": [
    "user",
    "company",
    "department",
    "branch",
    "valid_from",
    "valid_until",
    "can_manage_recruitment",
    "can_view_sensitive",
    "reason",
    "revoked"
  ],
  "fields": [
    {
      "fieldname": "user",
      "fieldtype": "Link",
      "label": "User",
      "options": "User",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "label": "Company",
      "options": "Company",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "department",
      "fieldtype": "Link",
      "label": "Department",
      "options": "Department"
    },
    {
      "fieldname": "branch",
      "fieldtype": "Link",
      "label": "Branch",
      "options": "Branch"
    },
    {
      "fieldname": "valid_from",
      "fieldtype": "Date",
      "label": "Valid From",
      "reqd": 1,
      "default": "Today"
    },
    {
      "fieldname": "valid_until",
      "fieldtype": "Date",
      "label": "Valid Until"
    },
    {
      "fieldname": "can_manage_recruitment",
      "fieldtype": "Check",
      "label": "Can Manage Recruitment",
      "default": "0"
    },
    {
      "fieldname": "can_view_sensitive",
      "fieldtype": "Check",
      "label": "Can View Sensitive",
      "default": "0"
    },
    {
      "fieldname": "reason",
      "fieldtype": "Small Text",
      "label": "Reason",
      "reqd": 1
    },
    {
      "fieldname": "revoked",
      "fieldtype": "Check",
      "label": "Revoked",
      "default": "0",
      "in_list_view": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 0,
      "delete": 0
    }
  ],
  "track_changes": 1
}
