{
  "doctype": "DocType",
  "name": "Kandil Hiring Request",
  "module": "Kandil HR",
  "custom": 0,
  "engine": "InnoDB",
  "autoname": "hash",
  "field_order": [
    "company",
    "department",
    "title",
    "requested_by",
    "status",
    "exception_reason",
    "needs_exception",
    "lines",
    "approval_steps",
    "submitted_snapshot",
    "decision_reason",
    "decision_note",
    "requested_position",
    "request_kind",
    "amends",
    "baseline_modified",
    "revision",
    "need_reason",
    "replacement_employee",
    "employment_type",
    "required_by",
    "qualifications",
    "skills_required",
    "experience_required",
    "working_conditions",
    "requested_priority",
    "hr_priority",
    "route_snapshot"
  ],
  "fields": [
    {
      "fieldname": "company",
      "label": "Company",
      "fieldtype": "Link",
      "reqd": 1,
      "in_list_view": 1,
      "options": "Company"
    },
    {
      "fieldname": "department",
      "label": "Department",
      "fieldtype": "Link",
      "reqd": 1,
      "in_list_view": 1,
      "options": "Department"
    },
    {
      "fieldname": "title",
      "label": "Title",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "requested_by",
      "label": "Requested By",
      "fieldtype": "Link",
      "read_only": 1,
      "in_list_view": 1,
      "options": "User"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "default": "Draft",
      "read_only": 1,
      "in_list_view": 1,
      "options": "Draft\nPending\nReturned\nApproved\nRejected\nCancelled\nFilled\nApplied\nClosed"
    },
    {
      "fieldname": "exception_reason",
      "label": "Exception Reason",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "needs_exception",
      "label": "Needs Exception",
      "fieldtype": "Check",
      "read_only": 1
    },
    {
      "fieldname": "lines",
      "label": "Lines",
      "fieldtype": "Table",
      "reqd": 1,
      "options": "Kandil Request Line"
    },
    {
      "fieldname": "approval_steps",
      "label": "Approval Steps",
      "fieldtype": "Table",
      "read_only": 1,
      "options": "Kandil Approval Step"
    },
    {
      "fieldname": "submitted_snapshot",
      "label": "Submitted Snapshot",
      "fieldtype": "Code",
      "read_only": 1,
      "hidden": 1,
      "permlevel": 1
    },
    {
      "fieldname": "decision_reason",
      "label": "Decision Reason",
      "fieldtype": "Small Text",
      "read_only": 1
    },
    {
      "fieldname": "decision_note",
      "label": "Decision Note",
      "fieldtype": "Small Text",
      "read_only": 1,
      "permlevel": 1,
      "hidden": 1
    },
    {
      "fieldname": "requested_position",
      "label": "Requested Position",
      "fieldtype": "Link",
      "options": "Kandil Position"
    },
    {
      "fieldname": "request_kind",
      "label": "Request Kind",
      "fieldtype": "Select",
      "options": "New Recruitment\nAmendment",
      "default": "New Recruitment",
      "read_only": 1
    },
    {
      "fieldname": "amends",
      "label": "Amends",
      "fieldtype": "Link",
      "options": "Kandil Hiring Request",
      "read_only": 1
    },
    {
      "fieldname": "baseline_modified",
      "label": "Baseline Modified",
      "fieldtype": "Data",
      "read_only": 1,
      "hidden": 1
    },
    {
      "fieldname": "revision",
      "label": "Revision",
      "fieldtype": "Int",
      "default": 1,
      "read_only": 1
    },
    {
      "fieldname": "need_reason",
      "label": "Need Reason",
      "fieldtype": "Select",
      "options": "New Position\nReplacement\nTemporary Cover\nExpansion",
      "default": "Expansion"
    },
    {
      "fieldname": "replacement_employee",
      "label": "Replacement Employee",
      "fieldtype": "Link",
      "options": "Employee"
    },
    {
      "fieldname": "employment_type",
      "label": "Employment Type",
      "fieldtype": "Data"
    },
    {
      "fieldname": "required_by",
      "label": "Required By",
      "fieldtype": "Date"
    },
    {
      "fieldname": "qualifications",
      "label": "Qualifications",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "skills_required",
      "label": "Skills Required",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "experience_required",
      "label": "Experience Required",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "working_conditions",
      "label": "Working Conditions",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "requested_priority",
      "label": "Requested Priority",
      "fieldtype": "Select",
      "options": "Normal\nImportant\nCritical",
      "default": "Normal"
    },
    {
      "fieldname": "hr_priority",
      "label": "HR Priority",
      "fieldtype": "Select",
      "options": "Normal\nImportant\nCritical",
      "default": "Normal",
      "read_only": 1
    },
    {
      "fieldname": "route_snapshot",
      "label": "Route Snapshot",
      "fieldtype": "Code",
      "hidden": 1,
      "read_only": 1,
      "permlevel": 1
    }
  ],
  "permissions": [
    {
      "role": "Kandil Requester",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 0,
      "print": 1
    },
    {
      "role": "Kandil Approver",
      "read": 1,
      "write": 0,
      "create": 1,
      "report": 1,
      "export": 0,
      "print": 1
    },
    {
      "role": "Kandil Recruiter",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 0,
      "print": 1
    },
    {
      "role": "Kandil Sector Approver",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 0,
      "print": 1
    }
  ],
  "track_changes": 1,
  "title_field": "title",
  "search_fields": "title,requested_by,status"
}
