{
  "doctype": "DocType",
  "name": "Kandil Notification Outbox",
  "module": "Kandil HR",
  "custom": 0,
  "engine": "InnoDB",
  "autoname": "hash",
  "field_order": [
    "dedupe_name",
    "recipient",
    "subject",
    "body",
    "reference_doctype",
    "reference_name",
    "delivery_context",
    "payload_hash",
    "status",
    "attempts",
    "next_attempt",
    "delivered_at",
    "notification_log",
    "last_error",
    "manual_retries",
    "retry_reason"
  ],
  "fields": [
    {
      "fieldname": "dedupe_name",
      "fieldtype": "Data",
      "label": "Deduplication Identity",
      "reqd": 1,
      "read_only": 1,
      "unique": 1
    },
    {
      "fieldname": "recipient",
      "fieldtype": "Link",
      "label": "Recipient",
      "options": "User",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "subject",
      "fieldtype": "Data",
      "label": "Subject",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "body",
      "fieldtype": "Text",
      "label": "Body"
    },
    {
      "fieldname": "reference_doctype",
      "fieldtype": "Link",
      "label": "Reference Doctype",
      "options": "DocType"
    },
    {
      "fieldname": "reference_name",
      "fieldtype": "Dynamic Link",
      "label": "Reference Name",
      "options": "reference_doctype"
    },
    {
      "fieldname": "delivery_context",
      "fieldtype": "Code",
      "options": "JSON",
      "label": "Delivery Context",
      "read_only": 1
    },
    {
      "fieldname": "payload_hash",
      "fieldtype": "Data",
      "label": "Payload Hash",
      "reqd": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Pending\nRetry\nDelivered locally\nSuppressed\nFailed",
      "default": "Pending",
      "in_list_view": 1
    },
    {
      "fieldname": "attempts",
      "fieldtype": "Int",
      "label": "Attempts",
      "default": "0"
    },
    {
      "fieldname": "next_attempt",
      "fieldtype": "Datetime",
      "label": "Next Attempt"
    },
    {
      "fieldname": "delivered_at",
      "fieldtype": "Datetime",
      "label": "Delivered At"
    },
    {
      "fieldname": "notification_log",
      "fieldtype": "Link",
      "label": "Notification Log",
      "options": "Notification Log"
    },
    {
      "fieldname": "last_error",
      "fieldtype": "Small Text",
      "label": "Last Error"
    },
    {
      "fieldname": "manual_retries",
      "fieldtype": "Int",
      "label": "Manual Retries",
      "default": "0",
      "read_only": 1
    },
    {
      "fieldname": "retry_reason",
      "fieldtype": "Small Text",
      "label": "Retry Reason",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 0,
      "delete": 0
    }
  ],
  "track_changes": 1
}
