{
  "doctype": "DocType",
  "name": "Kandil Security Policy",
  "module": "Kandil HR",
  "custom": 0,
  "engine": "InnoDB",
  "autoname": "hash",
  "field_order": [
    "mfa_requirement",
    "policy_owner",
    "identity_design",
    "verification_notes",
    "review_date"
  ],
  "fields": [
    {
      "fieldname": "mfa_requirement",
      "fieldtype": "Select",
      "label": "Mfa Requirement",
      "options": "Not reviewed\nRequired for privileged users\nRequired for all HR users",
      "default": "Not reviewed"
    },
    {
      "fieldname": "policy_owner",
      "fieldtype": "Link",
      "label": "Policy Owner",
      "options": "User"
    },
    {
      "fieldname": "identity_design",
      "fieldtype": "Select",
      "label": "Identity Design",
      "options": "Frappe native - not verified\nFrappe native - verified\nExternal identity - pending",
      "default": "Frappe native - not verified"
    },
    {
      "fieldname": "verification_notes",
      "fieldtype": "Small Text",
      "label": "Verification Notes",
      "description": "Record evidence; this policy does not configure or enforce MFA."
    },
    {
      "fieldname": "review_date",
      "fieldtype": "Date",
      "label": "Review Date"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 0,
      "delete": 0
    }
  ],
  "track_changes": 1,
  "issingle": 1
}
